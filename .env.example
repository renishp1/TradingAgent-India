# Grow environment overlay.
# Copy to .env only on a private machine. Never commit secrets.
#
# PAPER TRADING IS THE ONLY SUPPORTED MODE.
# Setting any live-trading flag will refuse to start.

# --- execution (frozen) -------------------------------------------------
# Must remain "paper". Any other value is a hard error.
GROW_EXECUTION_MODE=paper

# These must stay false / unset. Grow will refuse to boot if they are true.
GROW_LIVE_TRADING=false
LIVE_TRADING_ENABLED=false

# --- market -------------------------------------------------------------
GROW_TIMEZONE=Asia/Kolkata
GROW_EXCHANGE=NSE

# --- paper book ---------------------------------------------------------
GROW_STARTING_CASH=1000000

# --- risk stamp (required) ----------------------------------------------
# No published default. Generate a private value:
#   python -c "import secrets; print(secrets.token_hex(32))"
# GROW_RISK_SECRET=

# --- model gateway ------------------------------------------------------
# Default is the deterministic mock. Real providers are optional later.
GROW_MODEL_PROVIDER=mock
# XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- market data (2A fixture only) --------------------------------------
# Licensed / live feeds are refuse-closed until architecture review.
GROW_DATA_PROVIDER=fixture
GROW_ALLOW_LIVE_FEED=false

# --- historical provider (2J recorded adapter only; no live HTTP) --------
# Credentials never belong in source, fixtures, tests, or committed config.
# GROW_HISTORICAL_API_KEY=

# --- live data (3A mock stream → paper only) -----------------------------
# Enables the paper loop. Does NOT attach a broker, 2A live feed, or 2C live chain.
# GROW_LIVE_DATA_ENABLED=false
# GROW_LIVE_DATA_PROVIDER=mock
# GROW_LIVE_DATA_PAPER_MODE=true
# GROW_LIVE_DATA_LIVE_TRADING=false

# --- Zerodha market-data smoke (quotes only; no orders) -----------------
# The paper app still refuses to boot when KITE_ACCESS_TOKEN is set.
# scripts/run_zerodha_smoke.py reads these and strips them before the boot lock.
# ZERODHA_SMOKE=1
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=

GROW_TRADINGAGENTS_ENABLED=true
GROW_MAX_DEBATE_ROUNDS=1
